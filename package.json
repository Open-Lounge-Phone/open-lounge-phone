{
  "name": "openloungephone",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source, screen-free intercom phone: device emulator, companion app, and pluggable edge/self-hosted backend.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "docs:protocol": "node packages/protocol/scripts/gen-docs.ts",
    "docs:federation": "node packages/federation/scripts/gen-spec.ts",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run build && npm start -w @openloungephone/server-selfhost"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
