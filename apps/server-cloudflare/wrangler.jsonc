{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opentincan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Companion app at /, device emulator at /device/ (assembled by `npm run assets`).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentincan",
      // Replaced by `opentincan deploy cloudflare` (M5) or `wrangler d1 create opentincan`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "opentincan-voicemail" }],
  // Voicemail transcripts: uncomment to bind Workers AI (billed per audio minute; local
  // `wrangler dev` then needs `wrangler login` because AI always runs remotely).
  // "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "HOUSEHOLD", "class_name": "HouseholdObject" },
      { "name": "PAIRING", "class_name": "PairingObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdObject", "PairingObject"] }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put):
  //   SETUP_TOKEN          one-time first-run token; open https://<worker>/#setup=<token>
  //   TURN_KEY_ID          Cloudflare Realtime TURN key id (optional; STUN-only without it)
  //   TURN_KEY_API_TOKEN   its API token
}
