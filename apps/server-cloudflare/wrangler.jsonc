{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openloungephone",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Companion app at /, device emulator at /device/ (assembled by `npm run assets`).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/fed/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openloungephone",
      // Replaced by `openloungephone deploy cloudflare` (M5) or `wrangler d1 create openloungephone`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "openloungephone-voicemail" }],
  // Voicemail transcripts: uncomment to bind Workers AI (billed per audio minute; local
  // `wrangler dev` then needs `wrangler login` because AI always runs remotely).
  // "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "HOUSEHOLD", "class_name": "HouseholdObject" },
      { "name": "PAIRING", "class_name": "PairingObject" },
      { "name": "FEDERATION", "class_name": "FederationObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HouseholdObject", "PairingObject"] },
    { "tag": "v2", "new_sqlite_classes": ["FederationObject"] }
  ],
  "observability": { "enabled": true },
  // OPEN_SIGNUP "1" lets anyone create an account; `scripts/deploy.ts --open-signup` sets it.
  "vars": { "OPEN_SIGNUP": "0" }
  // Secrets (wrangler secret put):
  //   SETUP_TOKEN          one-time first-run token; open https://<worker>/#setup=<token>
  //   TURN_KEY_ID          Cloudflare Realtime TURN key id (optional; STUN-only without it)
  //   TURN_KEY_API_TOKEN   its API token
  //   FED_PRIVATE_KEY      federation key (Ed25519 JWK); deploy.ts generates it once
  // Vars set by deploy.ts: PUBLIC_URL (https://<domain>), OPEN_SIGNUP.
}
