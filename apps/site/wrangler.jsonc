{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Project website at the root domain, served as static assets by Workers.
  "name": "openloungephone-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "openloungephone.app", "custom_domain": true }]
}
