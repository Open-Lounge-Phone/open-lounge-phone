---
// Starlight's footer, plus the project credit and (when configured) the Sponsor link.
import Default from "@astrojs/starlight/components/Footer.astro";
import { CREDIT, SPONSOR_URL } from "../consts.ts";
---

<Default {...Astro.props}><slot /></Default>
<p class="olp-credit">
  <a href={CREDIT.url} rel="noopener">{CREDIT.text}</a>
  {SPONSOR_URL && (
    <>
      {" · "}
      <a href={SPONSOR_URL} rel="noopener">Sponsor the project</a>
    </>
  )}
</p>

<style>
  .olp-credit {
    margin-top: 1.5rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .olp-credit a {
    color: inherit;
  }
</style>
