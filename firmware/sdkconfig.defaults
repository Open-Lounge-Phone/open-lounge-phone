# Open Lounge Phone: ESP32-S3 minimal board (ESP32-S3-WROOM-1U-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Two app slots (OTA) with rollback: partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Console on the native USB (USB-Serial-JTAG), as on the board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Octal PSRAM on the N16R8 module; boot without it on other dev boards
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# TLS: the certificate bundle (common roots) for wss://
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Speed: TLS handshakes do their ECC in software (the S3 has no ECC accelerator)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# Call audio: esp_peer needs DTLS with the SRTP extension
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_LWIP_MAX_SOCKETS=16

# Memory for calls. On a board, internal RAM fell to 9 KB at the start of a call (Wi-Fi and lwIP
# buffers, TLS/DTLS, a 36 KB audio stack), so the phone's larger packets (its offer, the DTLS
# flights) failed while small ones went. Wi-Fi/lwIP buffers, TLS/DTLS and allocations over 4 KB
# live in PSRAM; the audio task's stack too (audio.c).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# AES in software: the hardware AES reads its data by DMA, which failed with TLS/DTLS buffers in
# PSRAM (the simulator logs "[AES] Error reading from GDMA buffer" and stalls right after "SRTP
# connected OK", as the board did). One call's AES is light work for the CPU.
CONFIG_MBEDTLS_HARDWARE_AES=n
