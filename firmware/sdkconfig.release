# Release builds (layered on sdkconfig.defaults by tools/release.sh). Signed images: the Secure
# Boot V2 signature scheme (RSA-3072) without burning secure boot eFuses: the running firmware only
# accepts updates signed with the key that signed it (esp_ota_end checks). Real Secure Boot V2
# (the bootloader checks every boot, eFuses burned once) can use the same key: README "Updates".
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/ota_signing_key.pem"
# Encrypted storage: NVS encrypted with keys derived from an eFuse HMAC key (KEY5), burned on the
# first boot, one-time and irreversible (README "Encrypted storage").
CONFIG_OLP_STORAGE_ENCRYPTED=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
