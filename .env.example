# Public URL where people reach this server (used in the printed setup link).
# Browsers only allow microphone access on https:// or http://localhost, so put the server behind
# HTTPS (e.g. Caddy, or a Cloudflare Tunnel) for use beyond this machine.
PUBLIC_URL=http://localhost:8787

# STUN servers (comma-separated). Leave empty for LAN-only installs with no outside traffic.
STUN_URLS=stun:stun.cloudflare.com:3478

# TURN relay (bundled coturn). Replace your.host with this machine's public name or IP, and set a
# long random secret, e.g.: openssl rand -hex 32
TURN_URLS=turn:your.host:3478?transport=udp,turn:your.host:3478?transport=tcp
TURN_SECRET=change-me

# Open sign-up: 1 lets anyone create an account (with a passkey) and their own household, like a
# public hub. Leave unset for an invite-only family server.
# OPEN_SIGNUP=1

# Federation: people here can connect with (and call) people on other Open Lounge Phone servers.
# On by default; needs PUBLIC_URL to be the https:// name other servers reach you at. The server's
# key is created once in DATA_DIR/federation-key.jwk (keep it, and back it up: other servers pin
# it). FEDERATION=0 turns it off; connections between people on this server still work.
# FEDERATION=0

# Running a public server (all optional; see docs/hub.md):
# FAIR_USE=hub                  # the hub's fair-use allowance (unset = unlimited)
# TURNSTILE_SITE_KEY=           # Cloudflare Turnstile on sign-up (both keys)
# TURNSTILE_SECRET=
# OPERATORS=yourhandle          # who sees the Operator view
# FUNDING_BALANCE_USD=150       # show the funding card
# SPONSOR_URL=                  # GitHub Sponsors link; the Sponsor button stays hidden while unset
# TRUST_PROXY=1                 # behind your own reverse proxy (client IPs from X-Forwarded-For)

# Rooms (party lines, phone rooms, 3-way calls). Without a relay, rooms are peer to peer (end-to-end
# encrypted) and hold up to 4 people; 1:1 calls are always peer to peer. For bigger rooms run the
# bundled LiveKit (`docker compose --profile livekit up -d`) and set these; relayed rooms are
# encrypted in transit but not end to end. LIVEKIT_URL is what browsers connect to (wss:// behind
# your HTTPS proxy); LIVEKIT_API_URL is how this server reaches it (inside compose).
# LIVEKIT_URL=wss://livekit.your.host
# LIVEKIT_API_URL=http://host.docker.internal:7880
# LIVEKIT_API_KEY=openloungephone
# LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters
# FAIR_USE_ROOM_MINUTES=1000    # room minutes per account per month (with FAIR_USE)

# Voicemail transcripts (optional): any OpenAI-compatible speech-to-text endpoint, e.g. a local
# whisper.cpp server (`--inference-path /v1/audio/transcriptions`) or speaches/faster-whisper.
# TRANSCRIBE_URL=http://localhost:8080/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=
