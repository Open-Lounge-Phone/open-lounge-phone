(version 1)
# OpenLoungePhone: design rules = the intersection of common 2-layer fab capabilities
# (JLCPCB, PCBWay, OSH Park, Eurocircuits, Aisler, Seeed Fusion, NextPCB, ...), with margin.
# Nothing here needs a premium process. If a board ever needs tighter values, flag it in
# hardware/BOARD_REQUIREMENTS.md instead of editing this file silently.
# Copied next to the board as <board>.kicad_dru by the M2 layout scripts.

(rule "fab: min track width 0.15 mm"
	(constraint track_width (min 0.15mm)))

(rule "fab: min copper clearance 0.15 mm"
	(constraint clearance (min 0.15mm)))

(rule "fab: min drill 0.3 mm"
	(constraint hole_size (min 0.3mm)))

(rule "fab: via 0.6 / 0.3 mm (annular ring 0.15 mm)"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm))
	(constraint annular_width (min 0.15mm)))

(rule "fab: copper to board edge 0.3 mm"
	(constraint edge_clearance (min 0.3mm)))

(rule "fab: hole to hole 0.5 mm"
	(constraint hole_to_hole (min 0.5mm)))

(rule "fab: copper to hole 0.25 mm"
	(constraint hole_clearance (min 0.25mm)))

(rule "fab: silkscreen text >= 0.8 mm"
	(layer "?.Silkscreen")
	(constraint text_height (min 0.8mm))
	(constraint text_thickness (min 0.12mm)))

# Power widths are the net classes in the project (place.py): 0.6 mm VBUS/3V3.

# through-hole GND pads keep thermal reliefs for hand soldering; one resolved spoke is enough
# where neighbouring copper blocks the others (USB-C shell tabs)
(rule "thermal: min 1 spoke"
	(constraint min_resolved_spokes 1))

# ---- narrow, documented footprint-inherent exceptions ----
# Reverse-mount status LED (official KiCad footprint, Lite-On LTST-C230 land pattern): the pads
# end at the light cut-out the LED shines through, by design of the part. Drilled/milled NPTH.
(rule "waiver: reverse-mount LED pads to its own light hole"
	(condition "A.memberOfFootprint('LED_SMD:LED_1206_3216Metric_ReverseMount_Hole1.8x2.4mm') && B.memberOfFootprint('LED_SMD:LED_1206_3216Metric_ReverseMount_Hole1.8x2.4mm')")
	(constraint hole_clearance (min 0mm))
	(constraint edge_clearance (min 0mm)))

# Cherry MX hot-swap geometry: 3.0 mm socket holes vs 1.75 mm plate-peg holes are 0.46 mm
# apart (standard MX hot-swap land, fabricated routinely); both are NPTH.
(rule "waiver: MX hot-swap NPTH spacing"
	(condition "A.memberOfFootprint('OpenLoungePhone:Kailh_MX_Hotswap_CPG151101S11') && B.memberOfFootprint('OpenLoungePhone:Kailh_MX_Hotswap_CPG151101S11')")
	(constraint hole_to_hole (min 0.45mm)))
